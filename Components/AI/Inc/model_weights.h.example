#ifndef MODEL_WEIGHTS_H
#define MODEL_WEIGHTS_H
/* 占位桩（公开仓库用，不含真实训练权重 —— 权重为私有，禁止上传）。
 *
 * 用法（编译前，在本地执行）：
 *   cp Components/AI/Inc/model_weights.h.example Components/AI/Inc/model_weights.h
 * 然后把你的私有训练权重填入，或通过 W25Q64 运行时加载（推荐部署路径）。
 *
 * 本桩所有权重为 0，仅用于让工程通过编译；推理结果无意义。
 * 维度宏由 ai_config.h 统一提供，此处不再重复定义。
 */
const float c_centers[500]            = {0};
const float sigma_upper[500]          = {0};
const float sigma_lower[500]          = {0};
const float p_consequent_factors[500] = {0};
const float W_hid_in[5000]            = {0};
const float b_hid[100]                = {0};
const float beta[600]                 = {0};
#endif /* MODEL_WEIGHTS_H */
