#ifndef MODEL_Q_PARAMS_H
#define MODEL_Q_PARAMS_H
#include <stdint.h>
/* 占位桩（公开仓库用，不含真实量化参数 —— 由私有权重派生，禁止上传）。
 *
 * 用法（编译前，在本地执行）：
 *   cp Components/AI/Inc/model_q_params.h.example Components/AI/Inc/model_q_params.h
 * 并填入你的私有量化参数（scale / mult / shift）。
 *
 * 本桩所有 scale/mult/shift 为 0，int8 路径可编译但推理结果无意义。
 */
#ifndef AI_INPUT_DIM
#define AI_INPUT_DIM    10
#define AI_NUM_RULES   50
#define AI_HIDDEN_DIM  100
#define AI_Z_DIM       150
#define AI_OUTPUT_DIM  4
#endif

#define AI_ZP 0

#define SCALE_IN1_F    0.0f
#define SCALE_W1_F     0.0f
#define SCALE_OUT1_F   0.0f
#define FC1_MULT 0
#define FC1_SHIFT 0

#define SCALE_Z_F      0.0f
#define SCALE_BETA_F   0.0f
#define SCALE_OUT2_F   0.0f
#define FC2_MULT 0
#define FC2_SHIFT 0

#define SCALE_Z_H0_F   0.0f
#define SCALE_Z_HID_F  0.0f
#define SCALE_BETA_H0_F 0.0f
#define SCALE_BETA_HID_F 0.0f
#define FC2H0_MULT 0
#define FC2H0_SHIFT 0
#define FC2HID_MULT 0
#define FC2HID_SHIFT 0

#define AI_ACT_MIN (-128)
#define AI_ACT_MAX (127)
#endif /* MODEL_Q_PARAMS_H */
