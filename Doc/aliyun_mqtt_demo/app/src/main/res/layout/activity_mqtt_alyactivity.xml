                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:maxLines="1"/>

                    <TextView
                        android:id="@+id/textview_mqtt_interface_ultrasound_distance_unit"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/ultrasound_distance_unit"
                        android:textSize="16sp"
                        android:textColor="@color/black"/>
                </LinearLayout>

            </LinearLayout>

