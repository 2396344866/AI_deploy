        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Roll(翻滚)" android:textSize="12sp" android:textColor="#757575"/>
                <TextView android:id="@+id/textview_mqtt_interface_roll_show" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/black" android:textSize="16sp" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pitch(俯仰)" android:textSize="12sp" android:textColor="#757575"/>
                <TextView android:id="@+id/textview_mqtt_interface_pitch_show" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/black" android:textSize="16sp" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yaw(偏航)" android:textSize="12sp" android:textColor="#757575"/>
                <TextView android:id="@+id/textview_mqtt_interface_yaw_show" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/black" android:textSize="16sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            tools:ignore="UselessParent"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/button_mqtt_interface_button_on"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:padding="5dp"
                android:text="@string/on"
                android:textColor="#7B1FA2"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
            <Button
                android:id="@+id/button_mqtt_interface_button_off"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:text="@string/off"
                android:textColor="#7B1FA2"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
        </LinearLayout>




        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            tools:ignore="UselessParent"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/button_mqtt_interface_forward"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/forward"
                android:textColor="#7B1FA2"
                android:textSize="16sp"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
            <Button
                android:id="@+id/button_mqtt_interface_back"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/back"
                android:textColor="#7B1FA2"
                android:textSize="16sp"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            tools:ignore="UselessParent"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/button_mqtt_interface_left"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/left"
                android:textColor="#7B1FA2"
                android:textSize="16sp"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
            <Button
                android:id="@+id/button_mqtt_interface_right"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/right"
                android:textColor="#7B1FA2"
                android:textSize="16sp"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            tools:ignore="UselessParent"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/button_mqtt_interface_rotate_left"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/left_rotate"
                android:textColor="#7B1FA2"
                android:textSize="16sp"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />
            <Button
                android:id="@+id/button_mqtt_interface_rotate_right"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/right_rotate"
                android:textColor="#7B1FA2"
                android:textSize="16sp"
                tools:ignore="MissingPrefix,VisualLintButtonSize" />

        </LinearLayout>
        <Button
            android:id="@+id/button_mqtt_interface_stop"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:text="@string/stop"
            android:textColor="#7B1FA2"
            android:textSize="16sp"
            tools:ignore="MissingPrefix,VisualLintButtonSize" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>