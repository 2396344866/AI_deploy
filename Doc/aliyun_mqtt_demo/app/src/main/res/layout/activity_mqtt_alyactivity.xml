                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imageview_mqtt_interface_light_intensity"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_light_indensity"
                        android:contentDescription="@string/Light_intensity" />

                    <TextView
                        android:id="@+id/textview_mqtt_interface_Light_intensity_show"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:maxLines="1"
                        android:padding="5dp"
                        android:textColor="@color/black"
                        android:textColorHint="#004D40"
                        android:textSize="16sp"
                        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />
                    <TextView
                        android:id="@+id/textview_mqtt_interface_Light_intensity_uint"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/Light_intensity_unit"
                        android:layout_gravity="center"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:maxEms="10"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textIsSelectable="true"
                        tools:ignore="TextSizeCheck"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:padding="12dp">


                <TextView
                    android:id="@+id/textview_mqtt_interface_smoke_density_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="@string/smoke_density"
                    android:textSize="14sp"
                    android:textColor="#757575"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imageview_mqtt_interface_smoke_density"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_smoke_density"
                        android:contentDescription="@string/Light_intensity" />
                    <TextView
                        android:id="@+id/textview_mqtt_interface_smoke_density_show"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:importantForAutofill="no"
                        android:maxLines="1"
                        android:padding="5dp"
                        android:textColor="@color/black"
                        android:textColorHint="#004D40"
                        android:textSize="16sp"
                        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />
                    <TextView
                        android:id="@+id/textview_mqtt_interface_smoke_density_uint"
                        android:layout_width="0dp"
                        android:layout_weight="0.5"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/smoke_density_unit"
                        android:layout_gravity="center"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:maxEms="10"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textIsSelectable="true"
                        tools:ignore="TextSizeCheck"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            tools:ignore="UselessParent">


            <LinearLayout
